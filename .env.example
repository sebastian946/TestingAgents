# Copy this file to .env (at the repo root) and adjust the values if needed.
# It is read by docker-compose (with --env-file .env) and by the API (config/variables.py).

# PostgreSQL
DB_USER=myuser
DB_PASSWORD=password
DB_NAME=local
# 5433 to avoid clashing with a PostgreSQL installed on Windows (which uses 5432)
DB_PORT=5433
# PostgreSQL host as seen from the API. Locally: localhost
ENDPOINT=localhost

# Redis
REDIS_PORT=6379
# Redis host as seen from the API and the worker. Locally: localhost
REDIS_HOST=localhost

# Authentication (WTA-26). Users register with email + password and receive a JWT signed
# with this key. REQUIRED. Generate a real one (the placeholder makes the API warn at start):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out; nothing else is lost.
AUTH_SECRET_KEY=change-me-generate-a-real-secret
# Token lifetime in minutes (default: one day) and jobs a user may create per hour
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_MAX_JOBS_PER_HOUR=20

# Reliability (WTA-8): seconds one attempt may run, and automatic retries of a job that raises
JOB_TIMEOUT_SECONDS=900
JOB_MAX_RETRIES=1

# Abuse protection (WTA-30): rate limits in Redis and the leaked-password check (HIBP)
RATE_LIMIT_ENABLED=true
PWNED_PASSWORDS_CHECK=true

# Error reporting (WTA-30): a Sentry project DSN; empty = off
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Data retention (WTA-30): finished jobs older than this are deleted with their files; 0 = never
RETENTION_DAYS=90

# Billing (WTA-30, ADR-09) through Lemon Squeezy. Accounts without a subscription are on
# DEFAULT_PLAN (free | starter | pro). Locally keep "pro" so you can test freely; production = free.
DEFAULT_PLAN=pro
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_STARTER=
# LEMONSQUEEZY_VARIANT_PRO=
# LEMONSQUEEZY_CHECKOUT_STARTER_URL=
# LEMONSQUEEZY_CHECKOUT_PRO_URL=

# Authenticated crawls (WTA-29): Fernet key that encrypts the login credentials a user gives
# for ONE job (deleted right after the crawl). Optional: without it, jobs with a login are
# refused with 503. Generate it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_KEY=

# Email (WTA-28): verification links and password resets. "console" prints the message to
# the API log (development); "resend" sends it through https://resend.com (free tier).
# A real deployment needs resend + a verified sender domain, and APP_URL = the public
# dashboard URL the links point to.
EMAIL_BACKEND=console
# RESEND_API_KEY=re_...
# EMAIL_FROM=Testing Agents <no-reply@yourdomain.com>
APP_URL=http://localhost:5173

# Production only (docker-compose.prod.yml; see docs/deployment.md). Leave them unset locally.
# DOMAIN=api.example.com                 # Caddy obtains the HTTPS certificate for this name
# REDIS_PASSWORD=                        # Redis AUTH; python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORS_ORIGINS=["https://app.example.com"]   # JSON list with the frontend's exact origin
# SQL_ECHO=false                         # the prod compose sets it; SQL logs off

# Designer agent (WTA-15): Claude API key and model settings.
# Get a key at https://platform.claude.com/ ; the API, the crawl and the tests run without it.
ANTHROPIC_API_KEY=
DESIGNER_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (more effort = better scenarios, more tokens)
DESIGNER_EFFORT=high
# Prompt folder under app/agents/prompts/designer/
DESIGNER_PROMPT_VERSION=v3
# WTA-16: retries for 429/529/5xx/timeouts (exponential backoff by the SDK), and the
# per-attempt timeout in seconds
DESIGNER_MAX_RETRIES=4
DESIGNER_TIMEOUT=300

# TEST ONLY: never set these in a real deployment. The integration test sets them for its own
# processes (see README, "Integration test").
# DESIGNER_MODE=fake          # deterministic scenarios from the page inventory, no Claude call
# SSRF_ALLOWED_HOSTS=["127.0.0.1"]   # hosts let through the anti-SSRF check
# RQ_QUEUE_NAME=default       # queue the API enqueues to and the worker listens on

# LangSmith tracing (optional): every job appears as a trace with the graph, its nodes and
# each Claude call (prompt, response, tokens). Get a key at https://smith.langchain.com/
# Traces include page content, the app description and the generated scenarios.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TestingAgents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: trace only a fraction of jobs (0 to 1), or keep prompts/responses out of traces
# LANGSMITH_TRACING_SAMPLING_RATE=0.25
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
