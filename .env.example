# Copia este archivo como .env (en la raiz del repo) y ajusta los valores si hace falta.
# Lo leen docker-compose (con --env-file .env) y la API (config/variables.py).

# PostgreSQL
DB_USER=myuser
DB_PASSWORD=password
DB_NAME=local
# 5433 para no chocar con un PostgreSQL instalado en Windows (usa el 5432)
DB_PORT=5433
# host de PostgreSQL visto desde la API. En local: localhost
ENDPOINT=localhost

# Redis
REDIS_PORT=6379
