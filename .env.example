# Copy this file to .env (at the repo root) and adjust the values if needed.
# It is read by docker-compose (with --env-file .env) and by the API (config/variables.py).

# PostgreSQL
DB_USER=myuser
DB_PASSWORD=password
DB_NAME=local
# 5433 to avoid clashing with a PostgreSQL installed on Windows (which uses 5432)
DB_PORT=5433
# PostgreSQL host as seen from the API. Locally: localhost
ENDPOINT=localhost

# Redis
REDIS_PORT=6379
# Redis host as seen from the API and the worker. Locally: localhost
REDIS_HOST=localhost
